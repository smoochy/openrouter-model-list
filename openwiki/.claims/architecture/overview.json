    {
      "id": "claim_f7d45f1750144aab9d5a28f51bc9560b",
      "statement": "The per-profile OpenRouter pipeline scores each candidate with `0.6*or_uptime + 0.3*latency_norm + 0.1*capability_norm`, then multiplies by `own_uptime`; latency is capped at 5s and capability is `context_length / max_context` across candidates. `own_uptime` returns `0.5` neutral when fewer than 3 probe samples exist, otherwise the success rate.",
      "evidence": [
        {
          "resource": "repo://scripts/scoring.py#L1-L66",
          "version": "repo-lines-v1:sha256:bb1d005198ac9525f158235466a1947e3aa3d838667705666d183871e1d66786:"

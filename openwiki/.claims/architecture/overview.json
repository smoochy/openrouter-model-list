    {
      "id": "claim_f79fb71fe8c948d88df1899ac5d5aa36",
      "statement": "Threshold filtering applies `min_param_b` as a hard floor (models with unparseable parameter counts are excluded unless allowlisted), buffers `min_context_length` and `min_max_output_tokens` by `buffer_pct`, relaxes `buffer_pct` step-wise toward 0 if the pool falls below `min_candidate_pool`, and `allowlist`/`hardallowlist` bypass floor/context/output checks (hardallowlist additionally bypasses structured-output and tool requirements).",
      "evidence": [
        {
          "resource": "repo://scripts/filters.py#L1-L109",
